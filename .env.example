# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# --- Optional backend: llama.cpp llama-server (the Ollama section below is the default) ---
LLAMA_CPP_DIR=E:\LLMCPP
LLAMA_MODEL_PATH=E:\LLMCPP\DeepSeek-R1-Distill-Qwen-1.5B-UD-Q4_K_XL.gguf
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
LLAMA_GPU_LAYERS=999
LLAMA_CONTEXT_SIZE=8192
LLAMA_PARALLEL_SLOTS=2
LLAMA_FLASH_ATTN=true
LLAMA_KV_CACHE_TYPE=q8_0
LLAMA_THREADS=6
LLAMA_USE_CHAT_TEMPLATE=false
LLAMA_LOG_PATH=logs/llama-server.log

# --- Local LLM serving (Ollama): Planner, Coder and Tool agent share ONE model and client ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_AGENT_MODEL=qwen2.5:7b-instruct
OLLAMA_AGENT_USE_GPU=true
OLLAMA_AGENT_CONTEXT_SIZE=8192
OLLAMA_AGENT_TIMEOUT=900

# --- Generation control (any backend) ---
CONSTRAIN_JSON=false

# --- Memory layer (mem0, local: Ollama embeddings + on-disk vector store) ---
MEMORY_PATH=.memory
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_EMBEDDING_DIMS=768
MEMORY_RECALL_LIMIT=3
MEMORY_RECALL_MAX_CHARS=600

# --- Orchestrator safety limits ---
MAX_RETRIES_PER_STEP=2
MAX_ORCHESTRATOR_STEPS=25

# --- Observability ---
LOG_LEVEL=INFO
OTEL_ENABLED=true
OTEL_EXPORTER=file
OTEL_TRACE_PATH=logs/traces.jsonl
FAILURE_LOG_PATH=logs/failures.jsonl

# --- Optional evaluation (off by default; free tier only, needs your own keys) ---
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=

# --- Sandbox ---
PROJECT_SANDBOX_ROOT=.
